# GEMINI_API_KEY: Opcional (inyectado automáticamente por AI Studio si se requiere)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública de la aplicación
APP_URL="MY_APP_URL"

# VITE_MERCADOPAGO_PAYMENT_URL: Link siempre activo de Mercado Pago ($5.990/mes) (también editable desde el panel Admin en Firestore).
VITE_MERCADOPAGO_PAYMENT_URL="https://mpago.la/2WauQDR"
VITE_PAYMENT_URL="https://mpago.la/2WauQDR"
# VITE_MERCADOPAGO_ANNUAL_PAYMENT_URL: Link siempre activo de Mercado Pago ($50.000/año · Oferta Anual).
VITE_MERCADOPAGO_ANNUAL_PAYMENT_URL="https://mpago.la/2JwG16F"

# MERCADOPAGO_ACCESS_TOKEN: Token opcional de Mercado Pago para verificar pagos vía API/Webhook
MERCADOPAGO_ACCESS_TOKEN=""

# PAYMENT_WEBHOOK_SECRET: Secreto compartido para validar webhooks de MercadoPago en server.ts
PAYMENT_WEBHOOK_SECRET="reemplazar_por_secreto_hmac"

# FIREBASE_SERVICE_ACCOUNT_JSON: JSON de cuenta de servicio de Firebase Admin (opcional para activar usuarios vía webhook en servidor)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ADMIN_SUPPORT_EMAIL: Correo administrador que recibe notificaciones de dudas y sugerencias
ADMIN_SUPPORT_EMAIL="jose.growy@gmail.com"

# RESEND_API_KEY: Opcional para enviar comprobantes de pago por correo al usuario y notificaciones al administrador
RESEND_API_KEY=""

# SUPPORT_WEBHOOK_URL: Opcional (webhook externo para reenviar tickets de soporte por correo/Slack/etc.)
SUPPORT_WEBHOOK_URL=""

# Web Push (VAPID): Opcionales para recordatorios push de vencimiento (si se omiten, server.ts genera claves persistentes locales)
VAPID_SUBJECT="mailto:jose.growy@gmail.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
